{
  "permissions": {
    "deny": [
      "EnterWorktree",
      "Bash(git worktree add:*)",
      "Bash(git worktree:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/posture_check.sh"
          }
        ]
      }
    ]
  }
}
